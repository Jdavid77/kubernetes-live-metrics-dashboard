# API Configuration
REACT_APP_API_URL=http://localhost:8080
REACT_APP_WS_URL=ws://localhost:8080
REACT_APP_REFRESH_INTERVAL=5000

# Logo (optional - URL to image, will be displayed as round)
REACT_APP_LOGO_URL=https://example.com/your-logo.png

# Social Links (optional)
REACT_APP_GITHUB_URL=https://github.com/yourusername
REACT_APP_LINKEDIN_URL=https://linkedin.com/in/yourusername

# Infrastructure Stack (optional - defaults shown)
REACT_APP_INFRA_OS=Talos
REACT_APP_INFRA_STORAGE=Longhorn/OpenEBS
REACT_APP_INFRA_CNI=Cilium
REACT_APP_INFRA_LOAD_BALANCER=Traefik
REACT_APP_INFRA_GITOPS=Flux CD
